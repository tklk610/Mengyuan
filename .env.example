# ============================================================
# NovelCraft PoC - 环境变量配置
# ============================================================

# ----- 运行环境 -----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ----- LLM Provider -----
# MiniMax (主用)
MINMAX_API_KEY=your-minimax-api-key-here
MINMAX_MODEL=MiniMax-Text-01

# OpenAI (备选)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic (备选)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest

# ----- Agent 配置（LangGraph）-----
DEEP_AGENTS_SKILLS_DIR=./skills
DEEP_AGENTS_INTERRUPT_ON_WRITE=true

# ----- Redis（LangGraph Checkpointer）-----
REDIS_URL=redis://localhost:6379/0

# ----- JWT Auth -----
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24

# ----- Database -----
DATABASE_URL=postgresql://novelcraft:password@localhost:5432/novelcraft

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000
